# Frontend (Vite)
# Use /api with the Vercel same-origin proxy. Use a full URL only for a direct backend deployment.
VITE_API_URL=/api
VITE_SOCKET_URL=https://benovelent-midax.onrender.com
VITE_SOCKET_UPGRADE=true
VITE_API_TIMEOUT=20000

VITE_LOGIN_VIDEO_URL=/videos/benevolent-login-loop.mp4
VITE_ABOUT_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_CONSTITUTION_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_GALLERY_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_NEWS_VIDEO_URL=/videos/benevolent-news-loop.mp4
VITE_CALL_RINGTONE_URL=/sounds/benovelent-call.mp3
VITE_APP_VERSION=18.5.0
# TURN/WebRTC credentials belong in backend/.env and are fetched at runtime by authenticated chat users.
# Populate these with the actual organisation/payment configuration before use.
VITE_MPESA_SHORTCODE=
VITE_MPESA_ACCOUNT_REFERENCE=
VITE_MPESA_MANUAL_PAYBILL=
VITE_MPESA_MANUAL_ACCOUNT_NUMBER=

# Backend configuration belongs in backend/.env.
