# Frontend Vite environment (safe for production; no secrets)
VITE_API_URL=https://benovelent-midax.onrender.com
VITE_SOCKET_URL=https://benovelent-midax.onrender.com
VITE_LOGIN_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_ABOUT_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_CONSTITUTION_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_GALLERY_VIDEO_URL=/videos/benevolent-community-loop.mp4
VITE_NEWS_VIDEO_URL=/videos/benevolent-news-loop.mp4

# Backend upload configuration (Render / backend env)
# Choose either CLOUDINARY_URL or the individual values below.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional local fallback paths if you do not use Cloudinary in development
UPLOAD_ROOT=./backend/uploads
DOCUMENT_ROOT=./backend/documents

# Web Push / phone notifications (generate VAPID keys; keep private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@midax.co.ke

# TalkBee SMS integration (set these from your TalkBee/API account)
TALKBEE_API_URL=
TALKBEE_API_TOKEN=
TALKBEE_SENDER_ID=
SMS_PROVIDER=talkbee

# Benovelent bundled call ringtone (override only with another browser-playable audio URL if needed)
VITE_CALL_RINGTONE_URL=/sounds/benovelent-call.mp3
