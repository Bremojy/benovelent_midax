/* NAVBAR */

.navbar {
  height: 80px;
  background: white;
  border-bottom: 1px solid #eeeeee;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.navbar-container {
  width: 90%;
  max-width: 1200px;
  height: 100%;
  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.logo-main {
  font-family: "Playfair Display", serif;
  font-size: 23px;
  font-weight: 700;
}

.logo-sub {
  color: var(--orange);
  font-size: 14px;
  letter-spacing: 3px;
  margin-top: 5px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 30px;
}

.nav-links a {
  font-size: 14px;
  font-weight: 600;
  transition: 0.3s;
}

.nav-links a:hover {
  color: var(--orange);
}

.admin-link {
  background: var(--orange);
  color: white !important;
  padding: 12px 20px;
  border-radius: 5px;
}

.menu-button {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
}

/* HERO */

.hero {
  min-height: 680px;

  display: flex;
  align-items: center;

  position: relative;

  background:
    linear-gradient(
      90deg,
      rgba(30, 30, 30, 0.95),
      rgba(30, 30, 30, 0.65),
      rgba(30, 30, 30, 0.2)
    ),
    url("/hero.jpg");

  background-size: cover;
  background-position: center;

  color: white;
}

/* ==========================================
   HERO SECTION
========================================== */

.hero {
    position: relative;
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: background-image 1s ease-in-out;
    animation: heroZoom 10s ease-in-out infinite alternate;
}

@keyframes heroZoom {
    from {
        background-size: 100%;
    }
    to {
        background-size: 110%;
    }
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            rgba(0,0,0,.70),
            rgba(0,0,0,.55)
        );
    backdrop-filter: blur(2px);
}

.hero-content {
    position: relative;
    z-index: 10;
    max-width: 760px;
    margin-left: 8%;
    color: white;
    animation: fadeUp .8s ease;
}

@keyframes fadeUp {
    from{
        opacity:0;
        transform:translateY(40px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.hero-label{
    display:inline-block;
    padding:8px 20px;
    border-radius:50px;
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(12px);
    color:#ff8c00;
    letter-spacing:3px;
    font-size:.85rem;
    font-weight:700;
    margin-bottom:20px;
}

.hero h1{
    font-size:4rem;
    line-height:1.15;
    font-weight:800;
    margin-bottom:25px;
}

.hero-description{
    font-size:1.15rem;
    line-height:1.8;
    max-width:620px;
    color:#ededed;
    margin-bottom:40px;
}

.hero-buttons{
    display:flex;
    gap:18px;
    flex-wrap:wrap;
}

.primary-button,
.secondary-button{

    display:flex;
    align-items:center;
    gap:10px;

    padding:16px 30px;

    border-radius:50px;

    text-decoration:none;

    font-weight:700;

    transition:.35s;
}

.primary-button{

    background:#ff7a00;

    color:white;

    box-shadow:
        0 15px 35px rgba(255,122,0,.35);

}

.primary-button:hover{

    transform:translateY(-4px);

    background:#ff931e;

}

.secondary-button{

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(12px);

    color:white;

    border:1px solid rgba(255,255,255,.25);

}

.secondary-button:hover{

    background:white;

    color:#222;

}

/* ==========================================
   ARROWS
========================================== */

.hero-arrow{

    position:absolute;

    top:50%;

    transform:translateY(-50%);

    width:60px;

    height:60px;

    border-radius:50%;

    border:none;

    cursor:pointer;

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

    background:rgba(255,255,255,.12);

    backdrop-filter:blur(18px);

    transition:.35s;

    z-index:20;

}

.hero-arrow:hover{

    background:#ff7a00;

    transform:translateY(-50%) scale(1.08);

}

.hero-arrow-left{

    left:30px;

}

.hero-arrow-right{

    right:30px;

}

/* ==========================================
   DOTS
========================================== */

.hero-dots{

    position:absolute;

    bottom:40px;

    left:50%;

    transform:translateX(-50%);

    display:flex;

    gap:12px;

    z-index:20;

}

.hero-dot{

    width:14px;

    height:14px;

    border-radius:50%;

    border:none;

    cursor:pointer;

    background:rgba(255,255,255,.45);

    transition:.35s;

}

.hero-dot.active{

    width:42px;

    border-radius:20px;

    background:#ff7a00;

}

/* ==========================================
   SCROLL
========================================== */

.hero-scroll{

    position:absolute;

    bottom:25px;

    right:35px;

    color:white;

    font-size:.85rem;

    letter-spacing:2px;

    opacity:.8;

    animation:bounce 2s infinite;

    z-index:20;

}

@keyframes bounce{

    0%,100%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-8px);

    }

}

/* ==========================================
   MOBILE
========================================== */

@media(max-width:992px){

.hero-content{

    margin:0 30px;

}

.hero h1{

    font-size:3rem;

}

.hero-description{

    font-size:1rem;

}

.hero-arrow{

    width:52px;

    height:52px;

}

}

@media(max-width:768px){

.hero{

    min-height:90vh;

    text-align:center;

}

.hero-content{

    margin:auto;

    padding:0 25px;

}

.hero h1{

    font-size:2.4rem;

}

.hero-description{

    font-size:.95rem;

}

.hero-buttons{

    justify-content:center;

}

.hero-arrow{

    display:none;

}

.hero-scroll{

    display:none;

}

}

@media(max-width:480px){

.hero h1{

    font-size:2rem;

}

.primary-button,
.secondary-button{

    width:100%;

    justify-content:center;

}

.hero-label{

    font-size:.72rem;

}

}

.hero-content {
  width: 90%;
  max-width: 1200px;
  margin: auto;

  position: relative;
  z-index: 2;
}

.hero-label {
  color: var(--orange);
  font-weight: 700;
  letter-spacing: 3px;
  font-size: 14px;
}

.hero h1 {
  font-size: 64px;
  line-height: 1.1;
  max-width: 750px;
  margin: 20px 0;
}

.hero-description {
  color: #eeeeee;
  max-width: 600px;
  font-size: 18px;
}

.hero-buttons {
  display: flex;
  gap: 15px;
  margin-top: 35px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  padding: 15px 25px;
  border-radius: 5px;

  font-weight: 600;
}

.primary-button {
  background: var(--orange);
  color: white;
}

.secondary-button {
  border: 1px solid white;
  color: white;
}

.primary-button:hover {
  background: var(--orange-dark);
}

.hero-scroll {
  position: absolute;
  bottom: 30px;
  left: 5%;

  color: #ddd;
  font-size: 12px;
  letter-spacing: 2px;
}

/* ABOUT */

.about-preview {
  background: white;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  margin-top: 50px;
}

.large-text {
  font-size: 22px;
  color: var(--dark);
  line-height: 1.6;
}

.text-link {
  display: inline-block;
  margin-top: 25px;
  color: var(--orange);
  font-weight: 700;
}


/* CENTER HEADING */

.center-heading {
  text-align: center;
  max-width: 700px;
  margin: auto;
}

.center-heading p:last-child {
  margin-top: 20px;
}


/* SERVICES */

.services-preview {
  background: var(--light-grey);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  margin-top: 60px;
}

.service-card {
  background: white;
  padding: 40px;
  border-radius: 8px;
  transition: 0.3s;
}

.service-card:hover {
  transform: translateY(-8px);
}

.service-icon {
  width: 65px;
  height: 65px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #fff1e5;
  color: var(--orange);

  border-radius: 50%;

  margin-bottom: 25px;
}

.service-card h3 {
  font-size: 25px;
  margin-bottom: 15px;
}

.service-card a {
  display: inline-block;
  margin-top: 20px;
  color: var(--orange);
  font-weight: 600;
}


/* CTA */

.cta-section {
  padding: 100px 10%;
  background: var(--dark);
  color: white;
  text-align: center;
}

.cta-section h2 {
  margin: 15px 0;
}

.cta-section p {
  color: #cccccc;
  margin-bottom: 30px;
}

@media (max-width: 768px) {

  .nav-links {
    position: absolute;
    top: 80px;
    left: 0;

    width: 100%;

    background: white;

    display: none;
    flex-direction: column;

    padding: 30px;
  }

  .nav-links.open {
    display: flex;
  }

  .menu-button {
    display: block;
  }

  .hero {
    min-height: 600px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .hero-description {
    font-size: 16px;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .service-grid {
    grid-template-columns: 1fr;
  }

  h2 {
    font-size: 34px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: flex-start;
  }

  .section {
    padding: 70px 0;
  }

}

/* ========================================= */
/* ADMIN DASHBOARD */
/* ========================================= */

.admin-layout {
  min-height: 100vh;
  display: flex;
  background: #f5f5f3;
}


/* ========================================= */
/* ADMIN SIDEBAR */
/* ========================================= */

.admin-sidebar {
  width: 260px;
  min-height: 100vh;

  background: #252525;
  color: white;

  display: flex;
  flex-direction: column;

  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;

  z-index: 1000;
}

.admin-logo {
  padding: 30px 25px;

  border-bottom: 1px solid #3d3d3d;
}

.admin-logo h2 {
  font-size: 25px;
  margin: 0;
}

.admin-logo span {
  color: #e8751a;
  font-size: 14px;
  letter-spacing: 3px;
}


/* ========================================= */
/* ADMIN NAVIGATION */
/* ========================================= */

.admin-nav {
  padding: 25px 15px;

  display: flex;
  flex-direction: column;

  gap: 5px;

  flex: 1;
}

.admin-nav button {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 14px 15px;

  background: transparent;
  border: none;

  color: #bbbbbb;

  border-radius: 6px;

  cursor: pointer;

  font-size: 14px;

  text-align: left;

  transition: 0.3s;
}

.admin-nav button:hover {
  background: #333333;
  color: white;
}

.admin-nav button.active {
  background: #e8751a;
  color: white;
}


/* ========================================= */
/* LOGOUT */
/* ========================================= */

.admin-logout {
  margin: 15px;

  padding: 15px;

  display: flex;
  align-items: center;

  gap: 12px;

  color: #bbbbbb;

  border-top: 1px solid #3d3d3d;
}

.admin-logout:hover {
  color: #e8751a;
}


/* ========================================= */
/* ADMIN MAIN */
/* ========================================= */

.admin-main {
  margin-left: 260px;

  width: calc(100% - 260px);

  min-height: 100vh;

  background: #f5f5f3;
}


/* ========================================= */
/* ADMIN HEADER */
/* ========================================= */

.admin-header {
  height: 90px;

  padding: 0 40px;

  background: white;

  border-bottom: 1px solid #eeeeee;

  display: flex;

  align-items: center;

  justify-content: space-between;
}

.admin-header p {
  color: #e8751a;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 2px;

  margin: 0;
}

.admin-header h1 {
  font-family: "Playfair Display", serif;

  font-size: 30px;

  margin-top: 5px;
}


/* ========================================= */
/* ADMIN USER */
/* ========================================= */

.admin-user {
  display: flex;

  align-items: center;

  gap: 12px;
}

.admin-avatar {
  width: 42px;
  height: 42px;

  background: #e8751a;

  color: white;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  font-weight: 700;
}

.admin-user div:last-child {
  display: flex;

  flex-direction: column;
}

.admin-user strong {
  font-size: 14px;
}

.admin-user span {
  font-size: 12px;

  color: #888888;
}


/* ========================================= */
/* DASHBOARD CONTENT */
/* ========================================= */

.dashboard-content {
  padding: 40px;
}


/* ========================================= */
/* WELCOME BOX */
/* ========================================= */

.welcome-box {
  background: #252525;

  color: white;

  padding: 40px;

  border-radius: 10px;

  margin-bottom: 30px;
}

.welcome-box h2 {
  margin: 10px 0;

  font-size: 32px;
}

.welcome-box p:not(.section-label) {
  color: #cccccc;
}


/* ========================================= */
/* ADMIN STATISTICS */
/* ========================================= */

.admin-stats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-bottom: 40px;
}

.admin-stat-card {
  background: white;

  padding: 25px;

  border-radius: 8px;

  display: flex;

  align-items: center;

  gap: 20px;

  border: 1px solid #eeeeee;
}

.admin-stat-card svg {
  width: 45px;
  height: 45px;

  padding: 10px;

  background: #fff1e5;

  color: #e8751a;

  border-radius: 8px;
}

.admin-stat-card div {
  display: flex;

  flex-direction: column;

  gap: 5px;
}

.admin-stat-card span {
  color: #777777;

  font-size: 13px;
}

.admin-stat-card strong {
  font-size: 25px;
}


/* ========================================= */
/* QUICK ACTIONS */
/* ========================================= */

.quick-actions {
  background: white;

  padding: 30px;

  border-radius: 8px;
}

.quick-actions h2 {
  font-size: 25px;

  margin-bottom: 25px;
}

.quick-grid {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 15px;
}

.quick-grid button {
  padding: 25px 15px;

  background: #f5f5f3;

  border: 1px solid #eeeeee;

  border-radius: 8px;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 12px;

  cursor: pointer;

  color: #333333;

  transition: 0.3s;
}

.quick-grid button svg {
  color: #e8751a;
}

.quick-grid button:hover {
  background: #e8751a;

  color: white;

  transform: translateY(-3px);
}

.quick-grid button:hover svg {
  color: white;
}


/* ========================================= */
/* ADMIN SECTIONS */
/* ========================================= */

.admin-section {
  padding: 40px;

  max-width: 900px;
}

.admin-section h2 {
  font-size: 32px;

  margin-bottom: 10px;
}

.admin-section > p {
  margin-bottom: 30px;
}


/* ========================================= */
/* ADMIN FORMS */
/* ========================================= */

.admin-section label {
  display: block;

  font-weight: 600;

  font-size: 14px;

  margin-top: 25px;

  margin-bottom: 8px;
}

.admin-section input,
.admin-section textarea {
  width: 100%;

  padding: 15px;

  border: 1px solid #dddddd;

  border-radius: 6px;

  background: white;

  outline: none;

  font-size: 15px;
}

.admin-section input:focus,
.admin-section textarea:focus {
  border-color: #e8751a;
}


/* ========================================= */
/* UPLOAD BOX */
/* ========================================= */

.upload-box {
  margin-top: 30px;

  padding: 60px 30px;

  background: white;

  border: 2px dashed #dddddd;

  border-radius: 10px;

  text-align: center;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 15px;
}

.upload-box svg {
  color: #e8751a;
}

.upload-box input {
  margin-top: 10px;
}


/* ========================================= */
/* SAVE BUTTON */
/* ========================================= */

.save-button {
  margin-top: 30px;

  padding: 14px 25px;

  background: #e8751a;

  color: white;

  border: none;

  border-radius: 6px;

  font-weight: 600;

  cursor: pointer;

  transition: 0.3s;
}

.save-button:hover {
  background: #c75d0d;
}


/* ========================================= */
/* MOBILE ADMIN */
/* ========================================= */

.admin-menu-button {
  display: none;
}


@media (max-width: 900px) {

  .admin-sidebar {
    transform: translateX(-100%);

    transition: 0.3s;
  }

  .admin-sidebar.open {
    transform: translateX(0);
  }

  .admin-main {
    margin-left: 0;

    width: 100%;
  }

  .admin-menu-button {
    display: flex;

    position: fixed;

    top: 20px;

    left: 20px;

    z-index: 2000;

    width: 45px;

    height: 45px;

    align-items: center;

    justify-content: center;

    background: #e8751a;

    color: white;

    border: none;

    border-radius: 6px;

    cursor: pointer;
  }

  .admin-header {
    padding-left: 85px;
  }

  .admin-stats {
    grid-template-columns: 1fr;
  }

  .quick-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}


@media (max-width: 600px) {

  .dashboard-content {
    padding: 20px;
  }

  .admin-section {
    padding: 25px 20px;
  }

  .admin-header {
    height: 100px;
  }

  .admin-header h1 {
    font-size: 24px;
  }

  .admin-user {
    display: none;
  }

  .quick-grid {
    grid-template-columns: 1fr;
  }

}

.admin-logout {
  background: transparent;
  border: none;
  width: calc(100% - 30px);
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  font-size: 14px;
}

/* =========================================
   MODERN Benovelent MIDAX NAVBAR
========================================= */

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 78px;

  background: rgba(245, 245, 243, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  border-bottom: 1px solid rgba(232, 117, 26, 0.15);

  z-index: 9999;

  display: flex;
  align-items: center;

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.navbar-container {
  width: 100%;
  max-width: 1200px;

  margin: 0 auto;
  padding: 0 30px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}


/* =========================================
   LOGO
========================================= */

.logo {
  display: flex;
  align-items: center;
  gap: 8px;

  text-decoration: none;

  font-weight: 800;
  letter-spacing: -0.5px;

  transition: transform 0.3s ease;
}

.logo:hover {
  transform: translateY(-2px);
}

.logo-main {
  color: #333333;
  font-size: 25px;
}

.logo-sub {
  color: #e8751a;
  font-size: 25px;
}


/* =========================================
   NAVIGATION
========================================= */

.nav-links {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-links a {
  position: relative;

  padding: 10px 16px;

  color: #444444;

  text-decoration: none;

  font-size: 15px;
  font-weight: 600;

  border-radius: 6px;

  transition:
    color 0.3s ease,
    background 0.3s ease;
}


/* Orange underline */

.nav-links a:not(.admin-link)::after {
  content: "";

  position: absolute;

  left: 50%;
  bottom: 3px;

  width: 0;
  height: 2px;

  background: #e8751a;

  transform: translateX(-50%);

  transition: width 0.3s ease;
}

.nav-links a:not(.admin-link):hover::after {
  width: 60%;
}

.nav-links a:hover {
  color: #e8751a;
}


/* =========================================
   ADMIN LOGIN
========================================= */

.admin-link {
  margin-left: 10px;

  background: #e8751a !important;
  color: white !important;

  padding: 11px 20px !important;

  border-radius: 6px !important;

  box-shadow:
    0 5px 15px rgba(232, 117, 26, 0.22);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease !important;
}

.admin-link:hover {
  background: #cf6412 !important;

  color: white !important;

  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(232, 117, 26, 0.3);
}


/* =========================================
   MOBILE MENU BUTTON
========================================= */

.menu-button {
  display: none;

  border: none;

  background: transparent;

  color: #333333;

  cursor: pointer;

  padding: 8px;

  border-radius: 6px;

  transition:
    background 0.3s ease,
    color 0.3s ease;
}

.menu-button:hover {
  background: #e8751a;
  color: white;
}


/* =========================================
   MOBILE RESPONSIVE
========================================= */

@media (max-width: 768px) {

  .navbar {
    height: 70px;
  }

  .navbar-container {
    padding: 0 20px;
  }

  .logo-main,
  .logo-sub {
    font-size: 21px;
  }

  .menu-button {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .nav-links {
    position: absolute;

    top: 70px;
    left: 0;

    width: 100%;

    padding: 20px;

    display: none;

    flex-direction: column;
    align-items: stretch;

    gap: 5px;

    background: #f5f5f3;

    border-bottom:
      1px solid rgba(
        232,
        117,
        26,
        0.15
      );

    box-shadow:
      0 15px 30px
      rgba(0, 0, 0, 0.08);
  }

  .nav-links.open {
    display: flex;
  }

  .nav-links a {
    width: 100%;

    padding: 14px 16px;

    text-align: center;
  }

  .nav-links a:not(.admin-link)::after {
    display: none;
  }

  .admin-link {
    margin-left: 0;

    margin-top: 8px;

    text-align: center;
  }
}


/* =========================================
   PAGE OFFSET
========================================= */

/*
Because the navbar is fixed,
we need to prevent the hero from
hiding behind it.
*/

main {
  padding-top: 78px;
}

@media (max-width: 768px) {

  main {
    padding-top: 70px;
  }

}

/* ========================================
   MODERN NAVBAR
======================================== */

.navbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e5e5e5;
  backdrop-filter: blur(12px);
}

.navbar-container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 30px;
  height: 76px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}


/* ========================================
   LOGO
======================================== */

.logo {
  display: flex;
  align-items: center;
  gap: 11px;

  text-decoration: none;
  color: #333;

  transition: 0.3s ease;
}

.logo:hover {
  transform: translateY(-1px);
}

.logo-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #f28c28;
  color: white;

  font-size: 22px;
  font-weight: 800;

  box-shadow:
    0 5px 15px rgba(242, 140, 40, 0.25);
}

.logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.logo-main {
  font-size: 20px;
  font-weight: 800;
  color: #333;
  letter-spacing: -0.5px;
}

.logo-sub {
  margin-top: 4px;

  font-size: 10px;
  font-weight: 700;

  color: #f28c28;

  letter-spacing: 3px;
}


/* ========================================
   NAVIGATION
======================================== */

.nav-links {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-link {
  position: relative;

  padding: 10px 15px;

  text-decoration: none;

  color: #555;

  font-size: 15px;
  font-weight: 600;

  transition:
    color 0.3s ease,
    background 0.3s ease;
}

.nav-link:hover {
  color: #f28c28;
}

.nav-link.active {
  color: #f28c28;
}


/* Orange underline */

.nav-link.active::after {
  content: "";

  position: absolute;

  left: 15px;
  right: 15px;
  bottom: 2px;

  height: 2px;

  background: #f28c28;

  border-radius: 10px;
}


/* ========================================
   ADMIN LOGIN
======================================== */

.admin-link {
  margin-left: 10px;

  padding: 11px 20px;

  border-radius: 8px;

  background: #f28c28;
  color: white;

  text-decoration: none;

  font-size: 14px;
  font-weight: 700;

  transition:
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.admin-link:hover {
  background: #d97716;

  transform: translateY(-2px);

  box-shadow:
    0 6px 18px rgba(242, 140, 40, 0.25);
}


/* ========================================
   MOBILE MENU BUTTON
======================================== */

.menu-button {
  display: none;

  border: none;

  background: transparent;

  color: #444;

  cursor: pointer;

  padding: 8px;

  border-radius: 8px;

  transition:
    background 0.3s ease,
    color 0.3s ease;
}

.menu-button:hover {
  background: #f5f5f5;
  color: #f28c28;
}


/* ========================================
   RESPONSIVE NAVBAR
======================================== */

@media (max-width: 768px) {

  .navbar-container {
    height: 68px;
    padding: 0 20px;
  }

  .menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-links {

    position: absolute;

    top: 68px;
    left: 0;

    width: 100%;

    display: none;

    flex-direction: column;
    align-items: stretch;

    gap: 0;

    padding: 15px 20px 20px;

    background: white;

    border-bottom: 1px solid #e5e5e5;

    box-shadow:
      0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .nav-links.open {
    display: flex;
  }

  .nav-link {

    width: 100%;

    padding: 14px 15px;

    border-radius: 7px;
  }

  .nav-link:hover {
    background: #f7f7f7;
  }

  .nav-link.active::after {
    display: none;
  }

  .nav-link.active {
    background: #fff4e8;
  }

  .admin-link {

    margin: 10px 0 0;

    text-align: center;

    padding: 13px;
  }

  .logo-main {
    font-size: 18px;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
  }

}
/* ========================================
   MODERN MEMBERS PAGE
   GREY + ORANGE THEME
======================================== */

.member-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin: 30px 0;
}

.member-stat-card {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 18px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 110px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
  transition: all 0.25s ease;
}

.member-stat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
  border-color: #f28c28;
}

.member-stat-card .stat-icon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: #fff1e3;
  color: #f28c28;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-stat-card span {
  display: block;
  color: #777777;
  font-size: 13px;
  font-weight: 500;
  margin-bottom: 6px;
}

.member-stat-card strong {
  display: block;
  color: #333333;
  font-size: 24px;
  font-weight: 700;
}


/* ========================================
   MEMBER TOOLBAR
======================================== */

.member-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 25px 0 20px;
  gap: 20px;
}

.search-box {
  width: 100%;
  max-width: 550px;
  height: 52px;
  background: #ffffff;
  border: 1px solid #dddddd;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 18px;
  color: #777777;
  transition: all 0.25s ease;
}

.search-box:focus-within {
  border-color: #f28c28;
  box-shadow: 0 0 0 4px rgba(242, 140, 40, 0.1);
}

.search-box input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: #333333;
  font-size: 14px;
}

.search-box input::placeholder {
  color: #999999;
}


/* ========================================
   MEMBERS TABLE
======================================== */

.members-table-container {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 18px;
  overflow-x: auto;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
}

.members-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 900px;
}

.members-table thead {
  background: #f7f7f7;
}

.members-table th {
  padding: 18px 20px;
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  color: #666666;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 1px solid #e5e5e5;
}

.members-table td {
  padding: 19px 20px;
  color: #555555;
  font-size: 14px;
  border-bottom: 1px solid #eeeeee;
  vertical-align: middle;
}

.members-table tbody tr {
  transition: background 0.2s ease;
}

.members-table tbody tr:hover {
  background: #fffaf5;
}

.members-table tbody tr:last-child td {
  border-bottom: none;
}

.members-table td strong {
  color: #333333;
  font-weight: 600;
}

.members-table td small {
  display: block;
  color: #999999;
  font-size: 12px;
  margin-top: 5px;
}


/* ========================================
   STATUS BADGES
======================================== */

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 12px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 700;
  text-transform: capitalize;
}

.status-badge.active {
  background: #e8f7ee;
  color: #218739;
}

.status-badge.inactive {
  background: #f1f1f1;
  color: #777777;
}


/* ========================================
   VIEW BUTTON
======================================== */

.edit-button {
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 10px;
  background: #fff1e3;
  color: #f28c28;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.edit-button:hover {
  background: #f28c28;
  color: #ffffff;
  transform: translateY(-2px);
}


/* ========================================
   EMPTY STATE
======================================== */

.empty-state {
  text-align: center;
  padding: 60px 20px !important;
  color: #999999;
}

.empty-state svg {
  color: #f28c28;
  margin-bottom: 10px;
}

.empty-state p {
  margin: 0;
  color: #777777;
}


/* ========================================
   MEMBER PROFILE MODAL
======================================== */

.member-details {
  margin-top: 25px;
  grid-template-columns: repeat(2, 1fr);
}

.member-details > div {
  background: #f8f8f8;
  border: 1px solid #eeeeee;
  border-radius: 12px;
  padding: 16px;
}

.member-details small {
  display: block;
  color: #888888;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 7px;
}

.member-details strong {
  display: block;
  color: #333333;
  font-size: 14px;
  font-weight: 600;
  word-break: break-word;
}

.member-details .status-badge {
  margin-top: 2px;
}


/* ========================================
   MODAL
======================================== */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(30, 30, 30, 0.65);
  backdrop-filter: blur(5px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 9999;
}

.member-modal {
  width: 100%;
  max-width: 650px;
  max-height: 90vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 22px;
  padding: 30px;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
  animation: memberModalIn 0.25s ease;
}

@keyframes memberModalIn {
  from {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid #eeeeee;
}

.modal-header h2 {
  margin: 5px 0 0;
  color: #333333;
  font-size: 25px;
}

.close-button {
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 10px;
  background: #f5f5f5;
  color: #555555;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.close-button:hover {
  background: #f28c28;
  color: #ffffff;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #eeeeee;
}


/* ========================================
   RESPONSIVE DESIGN
======================================== */

@media (max-width: 1100px) {

  .member-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 700px) {

  .member-stats-grid {
    grid-template-columns: 1fr;
  }

  .member-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-box {
    max-width: none;
  }

  .member-modal {
    padding: 22px;
    border-radius: 18px;
  }

  .member-details {
    grid-template-columns: 1fr !important;
  }

  .admin-page-header {
    flex-direction: column;
    align-items: flex-start;
  }

}

.contact-page{
    background:#f7f8fb;
}

.contact-hero{
    position:relative;
    padding:130px 20px 90px;
    background:linear-gradient(135deg,#343434,#ff7a00);
    color:white;
    overflow:hidden;
}

.hero-overlay{
    position:absolute;
    inset:0;
    background:
    radial-gradient(circle at top right,
    rgba(255,255,255,.15),
    transparent 50%);
}

.contact-hero .section-container{
    position:relative;
    z-index:2;
}

.contact-hero h1{
    font-size:58px;
    line-height:1.1;
    margin:15px 0;
}

.hero-description{
    max-width:650px;
    font-size:18px;
    opacity:.92;
}

.contact-wrapper{
    display:grid;
    grid-template-columns:1fr 1.2fr;
    gap:60px;
    align-items:start;
}

.contact-info h2{
    font-size:38px;
    margin-bottom:15px;
}

.contact-intro{
    color:#666;
    margin-bottom:35px;
    line-height:1.8;
}

.contact-card{
    display:flex;
    gap:20px;
    padding:22px;
    margin-bottom:20px;
    background:white;
    border-radius:18px;
    box-shadow:0 10px 30px rgba(0,0,0,.06);
    transition:.3s;
}

.contact-card:hover{
    transform:translateY(-5px);
}

.contact-icon{
    width:60px;
    height:60px;
    border-radius:15px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#ff7a00;
    color:white;
}

.contact-card h4{
    margin-bottom:6px;
}

.contact-card p{
    color:#666;
}

.contact-form-card{
    background:white;
    padding:45px;
    border-radius:25px;
    box-shadow:0 20px 60px rgba(0,0,0,.08);
}

.contact-form-card h2{
    margin-bottom:10px;
}

.contact-form-card p{
    color:#777;
    margin-bottom:30px;
}

.input-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.contact-form input,
.contact-form textarea{
    width:100%;
    padding:16px;
    border:1px solid #ddd;
    border-radius:12px;
    margin-bottom:18px;
    font-size:15px;
    transition:.3s;
}

.contact-form input:focus,
.contact-form textarea:focus{
    outline:none;
    border-color:#ff7a00;
    box-shadow:0 0 0 4px rgba(255,122,0,.12);
}

.contact-form button{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    padding:16px;
    border:none;
    border-radius:12px;
    background:#ff7a00;
    color:white;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    transition:.3s;
}

.contact-form button:hover{
    background:#e66d00;
    transform:translateY(-2px);
}

@media(max-width:900px){

.contact-wrapper{
grid-template-columns:1fr;
}

.contact-hero h1{
font-size:42px;
}

.input-grid{
grid-template-columns:1fr;
}

.contact-form-card{
padding:30px;
}

}
/* ===========================
   SERVICES HERO
=========================== */

.services-hero{
    position:relative;
    overflow:hidden;
    min-height:78vh;
    display:flex;
    align-items:center;
    background:linear-gradient(135deg,#1f2937 0%,#2f2f2f 45%,#444 100%);
    color:#fff;
}

.hero-background{
    position:absolute;
    inset:0;
}

.hero-circle{
    position:absolute;
    border-radius:50%;
    filter:blur(80px);
    opacity:.18;
}

.hero-circle-1{
    width:320px;
    height:320px;
    background:#ff8c00;
    top:-80px;
    left:-60px;
}

.hero-circle-2{
    width:260px;
    height:260px;
    background:#ffb347;
    right:-40px;
    bottom:60px;
}

.hero-circle-3{
    width:180px;
    height:180px;
    background:#ffffff;
    top:45%;
    left:55%;
    opacity:.08;
}

.services-hero-content{
    position:relative;
    z-index:2;
    max-width:760px;
    padding:100px 0;
}

.hero-badge{
    display:inline-block;
    background:rgba(255,140,0,.15);
    color:#ffb347;
    padding:10px 18px;
    border-radius:40px;
    font-size:.85rem;
    font-weight:700;
    letter-spacing:1px;
    margin-bottom:25px;
    border:1px solid rgba(255,140,0,.3);
}

.services-hero h1{
    font-size:clamp(2.8rem,6vw,4.8rem);
    line-height:1.1;
    margin-bottom:25px;
    font-weight:800;
}

.services-hero h1 span{
    color:#ffb347;
}

.services-hero p{
    font-size:1.15rem;
    color:#d6d6d6;
    line-height:1.8;
    max-width:650px;
    margin-bottom:40px;
}

.hero-buttons{
    display:flex;
    gap:18px;
    flex-wrap:wrap;
    margin-bottom:60px;
}

.hero-buttons a{
    text-decoration:none;
    background:#ff8c00;
    color:#fff;
    padding:15px 30px;
    border-radius:12px;
    font-weight:700;
    transition:.3s;
}

.hero-buttons a:hover{
    transform:translateY(-4px);
    box-shadow:0 14px 35px rgba(255,140,0,.35);
}

.hero-buttons .secondary{
    background:transparent;
    border:2px solid rgba(255,255,255,.25);
}

.hero-buttons .secondary:hover{
    background:#fff;
    color:#333;
}

.hero-stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:20px;
}

.hero-stats div{
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,.08);
    padding:22px;
    border-radius:18px;
}

.hero-stats strong{
    display:block;
    color:#ffb347;
    font-size:2rem;
    margin-bottom:8px;
}

.hero-stats span{
    color:#e2e2e2;
}
/*=========================================
MODERN SERVICE CARDS
=========================================*/

.services-modern-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

gap:35px;

margin-top:70px;

}

.modern-service-card{

background:#fff;

border-radius:24px;

padding:35px;

box-shadow:0 20px 60px rgba(0,0,0,.08);

transition:.35s;

position:relative;

overflow:hidden;

border:1px solid #ececec;

}

.modern-service-card::before{

content:"";

position:absolute;

left:0;

top:0;

width:100%;

height:5px;

background:linear-gradient(90deg,#ff7a00,#ffb347);

}

.modern-service-card:hover{

transform:translateY(-12px);

box-shadow:0 35px 70px rgba(0,0,0,.15);

}

.modern-service-card.featured{

transform:scale(1.03);

border:2px solid #ff8c00;

}

.service-top{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:25px;

}

.service-icon-box{

width:74px;

height:74px;

display:flex;

align-items:center;

justify-content:center;

border-radius:18px;

color:white;

}

.orange{

background:linear-gradient(135deg,#ff7a00,#ffb347);

}

.blue{

background:linear-gradient(135deg,#2563eb,#38bdf8);

}

.red{

background:linear-gradient(135deg,#ef4444,#fb7185);

}

.service-tag{

background:#fff4e8;

color:#ff7a00;

padding:8px 14px;

border-radius:30px;

font-size:.8rem;

font-weight:700;

}

.modern-service-card h2{

margin:20px 0;

font-size:1.7rem;

color:#2f2f2f;

}

.modern-service-card p{

color:#666;

line-height:1.8;

margin-bottom:25px;

}

.modern-service-card ul{

list-style:none;

padding:0;

margin:0;

}

.modern-service-card li{

padding:12px 0;

border-bottom:1px solid #f1f1f1;

font-weight:500;

color:#555;

transition:.3s;

}

.modern-service-card li:last-child{

border-bottom:none;

}

.modern-service-card li:hover{

padding-left:10px;

color:#ff7a00;

}

/*=========================================
IMPORTANT CARD
=========================================*/

.important-card{

display:flex;

align-items:center;

gap:35px;

margin-top:80px;

padding:45px;

border-radius:24px;

background:linear-gradient(135deg,#fff7ef,#ffffff);

box-shadow:0 20px 60px rgba(0,0,0,.08);

border-left:8px solid #ff8c00;

}

.important-icon{

width:90px;

height:90px;

display:flex;

align-items:center;

justify-content:center;

background:linear-gradient(135deg,#ff8c00,#ffb347);

color:white;

border-radius:22px;

flex-shrink:0;

}

.important-card h2{

margin:10px 0;

font-size:2rem;

color:#2f2f2f;

}

.important-card p{

line-height:1.8;

color:#666;

}

/*=========================================
CTA
=========================================*/

.services-cta{

margin-top:100px;

margin-bottom:40px;

}

.cta-box{

padding:70px 50px;

border-radius:30px;

background:linear-gradient(135deg,#2f2f2f,#4b5563);

text-align:center;

color:white;

position:relative;

overflow:hidden;

}

.cta-box::before{

content:"";

position:absolute;

width:260px;

height:260px;

border-radius:50%;

background:rgba(255,140,0,.12);

top:-120px;

right:-80px;

}

.cta-box::after{

content:"";

position:absolute;

width:180px;

height:180px;

border-radius:50%;

background:rgba(255,255,255,.05);

bottom:-80px;

left:-50px;

}

.cta-box>*{

position:relative;

z-index:2;

}

.cta-box h2{

font-size:clamp(2rem,5vw,3rem);

margin:20px 0;

}

.cta-box p{

max-width:700px;

margin:auto;

color:#ddd;

line-height:1.8;

}

.cta-buttons{

display:flex;

justify-content:center;

gap:20px;

flex-wrap:wrap;

margin-top:40px;

}

.cta-buttons a{

text-decoration:none;

padding:16px 36px;

border-radius:12px;

font-weight:700;

transition:.35s;

}

.cta-primary{

background:#ff8c00;

color:white;

}

.cta-primary:hover{

transform:translateY(-5px);

box-shadow:0 18px 35px rgba(255,140,0,.4);

}

.cta-secondary{

border:2px solid rgba(255,255,255,.3);

color:white;

}

.cta-secondary:hover{

background:white;

color:#333;

}

@media(max-width:768px){

.important-card{

flex-direction:column;

text-align:center;

}

.cta-box{

padding:50px 25px;

}

}

/*=============================
LOGIN PAGE
==============================*/

.modern-login-page{

min-height:100vh;

display:flex;

align-items:center;

justify-content:center;

position:relative;

overflow:hidden;

background:linear-gradient(135deg,#2f2f2f,#3e3e3e);

padding:40px;

}

.login-background{

position:absolute;

inset:0;

overflow:hidden;

}

.login-blob{

position:absolute;

border-radius:50%;

filter:blur(90px);

opacity:.25;

}

.blob1{

width:320px;

height:320px;

background:#ff8c00;

left:-100px;

top:-80px;

}

.blob2{

width:260px;

height:260px;

background:#ffb347;

right:-80px;

bottom:0;

}

.blob3{

width:180px;

height:180px;

background:white;

left:45%;

top:20%;

opacity:.08;

}

.login-wrapper{

position:relative;

z-index:2;

display:grid;

grid-template-columns:1fr 470px;

gap:70px;

align-items:center;

width:100%;

max-width:1200px;

}

.login-info{

color:white;

}

.brand-badge{

display:inline-block;

padding:10px 20px;

background:rgba(255,140,0,.15);

color:#ffb347;

border-radius:40px;

font-weight:700;

margin-bottom:25px;

}

.login-info h1{

font-size:4rem;

line-height:1.1;

margin-bottom:20px;

}

.login-info p{

font-size:1.1rem;

line-height:1.9;

color:#ddd;

max-width:520px;

}

.login-features{

margin-top:45px;

display:grid;

gap:18px;

}

.login-features div{

background:rgba(255,255,255,.08);

padding:18px;

border-radius:14px;

backdrop-filter:blur(12px);

}

.modern-login-card{

background:rgba(255,255,255,.97);

padding:45px;

border-radius:24px;

box-shadow:0 25px 70px rgba(0,0,0,.25);

}

.login-header{

text-align:center;

margin-bottom:35px;

}

.login-header h2{

font-size:2rem;

margin:10px 0;

}

.login-header span{

color:#777;

}

.login-button{

width:100%;

padding:16px;

margin-top:20px;

border:none;

border-radius:12px;

background:linear-gradient(135deg,#ff7a00,#ffb347);

color:white;

font-size:17px;

font-weight:700;

cursor:pointer;

transition:.3s;

}

.login-button:hover{

transform:translateY(-3px);

box-shadow:0 15px 35px rgba(255,140,0,.35);

}

@media(max-width:900px){

.login-wrapper{

grid-template-columns:1fr;

}

.login-info{

display:none;

}

}
/*=============================
PREMIUM INPUTS
=============================*/

.input-group{

display:flex;

align-items:center;

gap:12px;

background:#f7f7f7;

border:2px solid transparent;

padding:14px 16px;

border-radius:14px;

transition:.3s;

margin-bottom:22px;

}

.input-group:focus-within{

border-color:#ff8c00;

background:white;

box-shadow:0 0 0 4px rgba(255,140,0,.12);

}

.input-group input{

flex:1;

border:none;

background:none;

outline:none;

font-size:15px;

}

.input-group svg{

color:#888;

}

.password-toggle{

background:none;

border:none;

cursor:pointer;

display:flex;

align-items:center;

color:#888;

}

.password-toggle:hover{

color:#ff8c00;

}

.login-form label{

display:block;

font-weight:600;

margin-bottom:8px;

color:#444;

}

.login-error{

padding:16px;

margin-bottom:25px;

border-radius:12px;

background:#fff4f4;

color:#d32f2f;

font-weight:600;

border-left:5px solid #ef4444;

}

.login-button{

display:flex;

justify-content:center;

align-items:center;

gap:10px;

}

.spin{

animation:spin .9s linear infinite;

}

@keyframes spin{

to{

transform:rotate(360deg);

}

}

/* =========================================
   BUTTON
========================================= */

.login-form button{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    cursor:pointer;
    background:linear-gradient(135deg,#ff7a00,#ff9800);
    color:#fff;
    font-size:16px;
    font-weight:700;
    transition:.35s;
    margin-top:10px;
    box-shadow:0 15px 35px rgba(255,122,0,.35);
}

.login-form button:hover{
    transform:translateY(-3px);
    box-shadow:0 22px 45px rgba(255,122,0,.45);
}

.login-form button:active{
    transform:scale(.98);
}

.login-form button:disabled{
    opacity:.7;
    cursor:not-allowed;
}


/* =========================================
   ERROR
========================================= */

.login-error{
    margin-bottom:25px;
    padding:14px;
    border-radius:12px;
    background:#ffe8e8;
    color:#d62828;
    border:1px solid #ffc9c9;
    font-weight:600;
}


/* =========================================
   FLOATING SHAPES
========================================= */

.login-page::before{
    content:"";
    position:absolute;
    width:350px;
    height:350px;
    border-radius:50%;
    background:rgba(255,122,0,.15);
    top:-100px;
    left:-100px;
    filter:blur(10px);
    animation:floatOne 10s infinite alternate ease-in-out;
}

.login-page::after{
    content:"";
    position:absolute;
    width:300px;
    height:300px;
    border-radius:50%;
    background:rgba(255,255,255,.05);
    right:-80px;
    bottom:-80px;
    animation:floatTwo 8s infinite alternate ease-in-out;
}

@keyframes floatOne{
    from{
        transform:translateY(0px);
    }
    to{
        transform:translateY(50px);
    }
}

@keyframes floatTwo{
    from{
        transform:translateX(0px);
    }
    to{
        transform:translateX(-60px);
    }
}


/* =========================================
   RESPONSIVE
========================================= */

@media(max-width:768px){

.login-card{
    padding:35px 25px;
    width:92%;
}

.login-header h1{
    font-size:34px;
}

.login-form input{
    padding:15px;
}

}


/* =========================================
   CARD ANIMATION
========================================= */

@keyframes fadeLogin{
    from{
        opacity:0;
        transform:translateY(35px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

.login-card{
    animation:fadeLogin .8s ease;
}


/* =========================================
   LOGO GLOW
========================================= */

.login-header .section-label{
    animation:pulse 3s infinite;
}

@keyframes pulse{

0%{
    opacity:.7;
}

50%{
    opacity:1;
}

100%{
    opacity:.7;
}

}


/* =========================================
   INPUT ICON SUPPORT
========================================= */

.input-group{
    position:relative;
}

.input-group svg{
    position:absolute;
    left:16px;
    top:50%;
    transform:translateY(-50%);
    color:#999;
}

.input-group input{
    padding-left:48px;
}


/* =========================================
   SMOOTH TRANSITIONS
========================================= */

*{
    transition:
    background .25s,
    color .25s,
    border-color .25s;
}

/*==================================
FOOTER
==================================*/

.footer{
    background:#1f2937;
    color:#fff;
    margin-top:80px;
}

.footer-top{
    max-width:1300px;
    margin:auto;
    padding:70px 40px;
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1.3fr;
    gap:50px;
}

.footer-brand h2{
    font-size:32px;
    margin-bottom:15px;
}

.footer-brand span{
    color:#ff7a00;
}

.footer-brand p{
    color:#d1d5db;
    line-height:1.8;
    max-width:400px;
}

.footer h3{
    margin-bottom:18px;
    color:#fff;
}

.footer a{
    display:block;
    color:#cbd5e1;
    text-decoration:none;
    margin-bottom:12px;
    transition:.3s;
}

.footer a:hover{
    color:#ff7a00;
    transform:translateX(5px);
}

.footer-socials{
    display:flex;
    gap:15px;
    margin-top:30px;
}

.footer-socials a{
    width:45px;
    height:45px;
    border-radius:50%;
    background:#374151;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:.35s;
}

.footer-socials a:hover{
    background:#ff7a00;
    color:#fff;
    transform:translateY(-5px);
}

.footer-contact{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:18px;
    color:#d1d5db;
}

.footer-bottom{
    border-top:1px solid rgba(255,255,255,.1);
    padding:25px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    max-width:1300px;
    margin:auto;
}

.footer-bottom-links{
    display:flex;
    align-items:center;
    gap:20px;
}

.scroll-top{
    width:42px;
    height:42px;
    border:none;
    border-radius:50%;
    background:#ff7a00;
    color:#fff;
    cursor:pointer;
    transition:.3s;
}

.scroll-top:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 25px rgba(255,122,0,.45);
}

@media(max-width:900px){

.footer-top{
    grid-template-columns:1fr;
    text-align:center;
}

.footer-brand p{
    margin:auto;
}

.footer-socials{
    justify-content:center;
}

.footer-contact{
    justify-content:center;
}

.footer-bottom{
    flex-direction:column;
    gap:20px;
    text-align:center;
}

}
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: heroFade .8s ease;
}

.hero::before{
    content:"";
    position:absolute;
    inset:0;
    background:inherit;
    background-size:cover;
    background-position:center;
    transform:scale(1);
    animation:kenburns 12s linear infinite;
    filter:brightness(1.1) contrast(1.1) saturate(1.15);
}

@keyframes kenburns{
    0%{
        transform:scale(1);
    }
    100%{
        transform:scale(1.12);
    }
}

@keyframes heroFade{
    from{
        opacity:0;
    }
    to{
        opacity:1;
    }
}

.hero-overlay{
    position:absolute;
    inset:0;
    background:
    linear-gradient(
        90deg,
        rgba(0,0,0,.75) 0%,
        rgba(0,0,0,.45) 45%,
        rgba(0,0,0,.55) 100%
    );
    z-index:1;
}

.hero-content{
    position:relative;
    z-index:3;

    max-width:650px;

    margin-left:8%;

    padding:50px;

    border-radius:30px;

    background:rgba(255,255,255,.08);

    backdrop-filter:blur(20px);

    border:1px solid rgba(255,255,255,.15);

    box-shadow:
    0 25px 60px rgba(0,0,0,.35);
}

.hero h1{

    font-size:clamp(3rem,6vw,5.8rem);

    line-height:1.05;

    font-weight:800;

    margin:20px 0;

    color:white;

    letter-spacing:-2px;

    text-shadow:
    0 10px 25px rgba(0,0,0,.35);
}

.hero-description{

    font-size:1.2rem;

    line-height:1.9;

    color:rgba(255,255,255,.95);

    margin-bottom:35px;
}

.hero-label{

    display:inline-flex;

    align-items:center;

    gap:10px;

    padding:12px 22px;

    border-radius:50px;

    background:rgba(255,255,255,.15);

    border:1px solid rgba(255,255,255,.2);

    backdrop-filter:blur(12px);

    font-weight:600;

    letter-spacing:3px;

    text-transform:uppercase;

    font-size:.85rem;
}

.primary-button{

    display:flex;

    align-items:center;

    gap:12px;

    background:#16a34a;

    color:white;

    text-decoration:none;

    padding:16px 34px;

    border-radius:60px;

    font-weight:700;

    transition:.35s;

    box-shadow:
    0 15px 35px rgba(22,163,74,.35);
}

.primary-button:hover{

    transform:translateY(-5px);

    box-shadow:
    0 25px 45px rgba(22,163,74,.45);
}

.secondary-button{

    display:flex;

    align-items:center;

    justify-content:center;

    padding:16px 34px;

    border-radius:60px;

    color:white;

    border:2px solid rgba(255,255,255,.6);

    backdrop-filter:blur(10px);

    text-decoration:none;

    transition:.3s;
}

.secondary-button:hover{

    background:white;

    color:#111;
}

.hero-arrow{

    width:65px;

    height:65px;

    border-radius:50%;

    background:rgba(255,255,255,.12);

    backdrop-filter:blur(15px);

    color:white;

    border:none;

    cursor:pointer;

    transition:.3s;

    z-index:4;
}

.hero-arrow:hover{

    background:white;

    color:#111;

    transform:translateY(-50%) scale(1.1);
}

.hero-dot{

    width:12px;

    height:12px;

    border-radius:50%;

    background:rgba(255,255,255,.4);

    border:none;

    transition:.35s;
}

.hero-dot.active{

    width:42px;

    border-radius:30px;

    background:#16a34a;
}

.hero-scroll{

    position:absolute;

    bottom:30px;

    left:50%;

    transform:translateX(-50%);

    color:white;

    font-size:.9rem;

    letter-spacing:3px;

    animation:bounce 2s infinite;

    z-index:5;
}

@keyframes bounce{

    0%,20%,50%,80%,100%{

        transform:translate(-50%,0);

    }

    40%{

        transform:translate(-50%,-10px);

    }

    60%{

        transform:translate(-50%,-5px);

    }

}

@media(max-width:768px){

.hero{

min-height:90vh;

}

.hero-content{

margin:20px;

padding:30px;

text-align:center;

}

.hero h1{

font-size:2.6rem;

}

.hero-buttons{

justify-content:center;

flex-direction:column;

}

.primary-button,
.secondary-button{

width:100%;

justify-content:center;

}

.hero-arrow{

display:none;

}

.hero-scroll{

display:none;

}

}


.about-video-hero{position:relative;isolation:isolate;overflow:hidden}
.about-background-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;pointer-events:none;display:block;filter:saturate(1.08) brightness(.92);transform:scale(1.01)}
.about-video-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,18,20,.72),rgba(16,18,20,.28)),linear-gradient(180deg,rgba(255,122,0,.12),rgba(0,0,0,.58));z-index:1}
.about-video-hero .about-hero-content{position:relative;z-index:2}
.about-image{overflow:hidden;border-radius:26px;box-shadow:0 25px 60px rgba(0,0,0,.13);background:#f0f1f3}
.about-image img{display:block;width:100%;height:100%;min-height:390px;object-fit:cover}
@media(max-width:700px){.about-image img{min-height:280px}}

.contact-form-status{display:flex;align-items:center;gap:8px;margin:0 0 18px;padding:13px 15px;border-radius:12px;font-size:14px;font-weight:650}
.contact-form-status.success{background:#ecfdf3;color:#087443;border:1px solid #a7f3d0}
.contact-form-status.error{background:#fff1f2;color:#b42318;border:1px solid #fecdd3}
.contact-form input:disabled,.contact-form textarea:disabled{opacity:.65}
.contact-form button:disabled{opacity:.65;cursor:not-allowed;transform:none!important}

.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;background:#111;transition:opacity .5s ease}.hero{background:#111}.hero-overlay{z-index:2}.hero-content,.hero-arrow,.hero-dots,.hero-scroll{z-index:3}.hero-arrow{position:absolute;z-index:4}.hero-dots{z-index:4}.hero-scroll{z-index:4}


/* =========================================================
   MODERN WELCOME CAROUSEL
   ========================================================= */

.modern-hero {
  min-height: clamp(620px, 88vh, 860px);
  isolation: isolate;
  background: #101114;
  overflow: hidden;
  color: #fff;
}

.hero-media,

.hero-image-fallback{
  position:absolute;
  inset:0;
  z-index:0;
  background:
    radial-gradient(circle at 78% 28%, rgba(255,122,0,.25), transparent 28%),
    linear-gradient(135deg,#16191f,#242831 55%,#111318);
}

.hero-image-wash {
  position: absolute;
  inset: 0;
}

.hero-media {
  z-index: 0;
  overflow: hidden;
  background: #101114;
}

.modern-hero-image {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  animation: modernHeroKenBurns 11s ease-out both;
  filter: saturate(.92) contrast(1.03);
}

.hero-image-wash {
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(8, 10, 14, .94) 0%, rgba(8, 10, 14, .72) 42%, rgba(8, 10, 14, .25) 76%, rgba(8, 10, 14, .48) 100%),
    linear-gradient(180deg, rgba(5, 6, 8, .18), rgba(5, 6, 8, .72));
}

.hero-glow {
  position: absolute;
  z-index: 2;
  width: 30vw;
  height: 30vw;
  min-width: 220px;
  min-height: 220px;
  border-radius: 999px;
  filter: blur(80px);
  opacity: .16;
  pointer-events: none;
}

.hero-glow-one {
  background: #ff7a00;
  right: 8%;
  top: 18%;
}

.hero-glow-two {
  background: #8b5cf6;
  right: 25%;
  bottom: -18%;
}

.modern-hero-inner {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
  min-height: inherit;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 330px);
  align-items: center;
  gap: clamp(28px, 7vw, 100px);
  position: relative;
  z-index: 5;
  padding: 70px 0 100px;
}

.modern-hero-copy {
  max-width: 760px;
  animation: modernHeroCopyIn .7s ease both;
}

.hero-welcome-pill {
  width: fit-content;
  max-width: 100%;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 999px;
  background: rgba(255,255,255,.09);
  backdrop-filter: blur(18px);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.7px;
  margin-bottom: 18px;
}

.modern-hero .hero-label {
  margin-bottom: 13px;
  color: #ffad68;
  font-size: 12px;
  letter-spacing: 2.5px;
}

.modern-hero h1 {
  max-width: 820px;
  margin: 0;
  color: #fff;
  font-size: clamp(2.6rem, 6.2vw, 5.6rem);
  line-height: .98;
  letter-spacing: -.045em;
  text-wrap: balance;
}

.modern-hero .hero-description {
  max-width: 650px;
  margin: 25px 0 0;
  color: rgba(255,255,255,.82);
  font-size: clamp(1rem, 1.4vw, 1.17rem);
  line-height: 1.75;
}

.modern-hero .hero-buttons {
  margin-top: 30px;
}

.modern-primary-button,
.modern-secondary-button {
  min-height: 50px;
  padding: 14px 22px;
  border-radius: 15px;
}

.modern-primary-button {
  background: linear-gradient(135deg, #ff7a00, #ff9b3d);
  box-shadow: 0 18px 45px rgba(255, 122, 0, .25);
}

.modern-secondary-button {
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.2);
  backdrop-filter: blur(16px);
}

.modern-hero-side-card {
  align-self: end;
  margin-bottom: 18px;
  padding: 22px;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 24px;
  background: rgba(12, 13, 18, .45);
  backdrop-filter: blur(20px);
  box-shadow: 0 24px 70px rgba(0,0,0,.24);
  animation: modernHeroCardIn .9s .15s ease both;
}

.side-card-kicker {
  display: block;
  color: #ffad68;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
  margin-bottom: 9px;
}

.modern-hero-side-card strong {
  display: block;
  color: #fff;
  font-size: 19px;
  line-height: 1.25;
}

.modern-hero-side-card p {
  margin: 10px 0 15px;
  color: rgba(255,255,255,.68);
  font-size: 13px;
  line-height: 1.65;
}

.modern-hero-side-card a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
}

.modern-hero-controls {
  position: absolute;
  z-index: 8;
  left: max(24px, calc((100% - 1180px) / 2));
  bottom: 52px;
  width: min(520px, calc(100% - 48px));
}

.modern-hero-progress {
  display: flex;
  gap: 5px;
  height: 3px;
  margin-bottom: 13px;
}

.modern-hero-progress span {
  flex: 1;
  max-width: 90px;
  border-radius: 99px;
  background: rgba(255,255,255,.24);
  overflow: hidden;
  position: relative;
}

.modern-hero-progress span.active::after {
  content: "";
  position: absolute;
  inset: 0;
  background: #ff7a00;
  transform-origin: left;
  animation: heroProgress 6.5s linear both;
}

.modern-hero-control-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.modern-arrow {
  position: static;
  transform: none;
  width: 38px;
  height: 38px;
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.13);
  backdrop-filter: blur(15px);
}

.modern-arrow:hover {
  transform: translateY(-1px);
}

.hero-play-toggle {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 50%;
  background: rgba(255,255,255,.09);
  color: #fff;
  cursor: pointer;
}

.hero-slide-counter {
  margin-left: 7px;
  color: rgba(255,255,255,.7);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.modern-hero-scroll {
  left: auto;
  right: max(24px, calc((100% - 1180px) / 2));
  bottom: 55px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(255,255,255,.62);
}

.scroll-line {
  display: block;
  width: 38px;
  height: 1px;
  background: rgba(255,255,255,.35);
}

.hero-loading-indicator {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  z-index: 20;
  overflow: hidden;
}

.hero-loading-indicator span {
  display: block;
  width: 30%;
  height: 100%;
  background: #ff7a00;
  animation: heroLoading 1s ease-in-out infinite;
}

@keyframes modernHeroKenBurns {
  from { transform: scale(1.015); }
  to { transform: scale(1.075); }
}

@keyframes modernHeroCopyIn {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes modernHeroCardIn {
  from { opacity: 0; transform: translateY(20px) translateX(10px); }
  to { opacity: 1; transform: translateY(0) translateX(0); }
}

@keyframes heroProgress {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes heroLoading {
  from { transform: translateX(-120%); }
  to { transform: translateX(420%); }
}

@media (max-width: 900px) {
  .modern-hero {
    min-height: 760px;
  }

  .modern-hero-inner {
    grid-template-columns: 1fr;
    align-content: center;
    padding-top: 90px;
    padding-bottom: 160px;
  }

  .modern-hero-side-card {
    display: none;
  }

  .modern-hero h1 {
    font-size: clamp(2.6rem, 10vw, 4.2rem);
  }

  .modern-hero-controls {
    bottom: 40px;
  }

  .modern-hero-scroll {
    display: none;
  }

  .hero-image-wash {
    background:
      linear-gradient(180deg, rgba(8,10,14,.54), rgba(8,10,14,.86) 86%),
      linear-gradient(90deg, rgba(8,10,14,.35), rgba(8,10,14,.35));
  }
}

@media (max-width: 560px) {
  .modern-hero {
    min-height: 720px;
  }

  .modern-hero-inner {
    width: calc(100% - 30px);
    padding: 78px 0 150px;
  }

  .hero-welcome-pill {
    font-size: 9px;
    letter-spacing: 1.2px;
  }

  .modern-hero h1 {
    font-size: clamp(2.35rem, 12vw, 3.4rem);
    line-height: 1.02;
  }

  .modern-hero .hero-description {
    margin-top: 18px;
    font-size: .96rem;
    line-height: 1.65;
  }

  .modern-hero .hero-buttons {
    margin-top: 24px;
    gap: 9px;
  }

  .modern-hero .primary-button,
  .modern-hero .secondary-button {
    width: auto;
    min-height: 47px;
    padding: 12px 17px;
  }

  .modern-hero-controls {
    left: 15px;
    bottom: 27px;
    width: calc(100% - 30px);
  }

  .modern-hero-progress span {
    max-width: none;
  }
}

/* =========================================================
   DATA INTEGRITY PAGE
   ========================================================= */

.integrity-page .portal-module-header {
  align-items: flex-end;
}

.integrity-actions {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.integrity-health {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  margin-bottom: 18px;
  border: 1px solid rgba(16,185,129,.2);
  border-radius: 18px;
  background: rgba(16,185,129,.06);
}

.integrity-health.attention {
  border-color: rgba(245,158,11,.24);
  background: rgba(245,158,11,.07);
}

.integrity-health.checking {
  border-color: rgba(99,102,241,.2);
  background: rgba(99,102,241,.06);
}

.integrity-health-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 14px;
  background: rgba(255,255,255,.75);
}

.integrity-health strong {
  display: block;
  margin-bottom: 3px;
}

.integrity-health p {
  margin: 0;
  font-size: 13px;
}

.integrity-count-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 10px;
}

.integrity-count {
  min-width: 0;
  padding: 15px;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 15px;
  background: #fafafa;
}

.integrity-count span {
  display: block;
  color: #71717a;
  font-size: 11px;
  line-height: 1.35;
}

.integrity-count strong {
  display: block;
  margin-top: 6px;
  font-size: 25px;
}

.integrity-policy-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 10px;
}

.integrity-policy {
  display: flex;
  gap: 12px;
  padding: 16px;
  border-radius: 16px;
  background: #fafafa;
  border: 1px solid rgba(0,0,0,.06);
}

.integrity-policy > div {
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #fff1e5;
  color: #e8751a;
}

.integrity-policy strong {
  display: block;
}

.integrity-policy p {
  margin: 4px 0 0;
  font-size: 12px;
  line-height: 1.6;
}

.integrity-duplicate-list {
  display: grid;
  gap: 10px;
}

.integrity-duplicate-group {
  padding: 14px;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 15px;
}

.integrity-duplicate-head {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 9px;
  border-bottom: 1px solid rgba(0,0,0,.06);
}

.integrity-duplicate-head span {
  color: #71717a;
  font-size: 12px;
}

.integrity-record {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 9px 0 0;
  font-size: 13px;
}

.integrity-record small {
  color: #71717a;
  text-align: right;
  overflow-wrap: anywhere;
}

.portal-alert.success {
  display: flex;
  align-items: center;
  gap: 8px;
}

.portal-alert.warning {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 15px;
}

.spin {
  animation: spin .8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 800px) {
  .integrity-page .portal-module-header {
    align-items: flex-start;
  }

  .integrity-actions {
    width: 100%;
  }

  .integrity-actions .portal-btn {
    flex: 1;
    justify-content: center;
  }

  .integrity-count-grid {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .integrity-policy-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .integrity-count-grid {
    grid-template-columns: 1fr 1fr;
  }

  .integrity-count {
    padding: 12px;
  }

  .integrity-count strong {
    font-size: 21px;
  }

  .integrity-record {
    display: block;
  }

  .integrity-record small {
    display: block;
    margin-top: 3px;
    text-align: left;
  }
}

/* Modern public content rhythm */
.modern-section-head{max-width:860px}
.modern-section-head p,.modern-card p{max-width:72ch}
.modern-card-grid>.modern-card{
  opacity:0;
  transform:translateY(22px);
  animation:publicCardReveal .65s cubic-bezier(.2,.7,.2,1) forwards;
}
.modern-card-grid>.modern-card:nth-child(2){animation-delay:.08s}
.modern-card-grid>.modern-card:nth-child(3){animation-delay:.16s}
.modern-card-grid>.modern-card:nth-child(4){animation-delay:.24s}
.modern-card-grid>.modern-card:nth-child(5){animation-delay:.32s}
.modern-card-grid>.modern-card:nth-child(6){animation-delay:.40s}
.modern-card-grid>.modern-card:nth-child(7){animation-delay:.48s}
.modern-card-grid>.modern-card:nth-child(8){animation-delay:.56s}
.modern-card{transition:transform .28s ease,box-shadow .28s ease,border-color .28s ease}
.modern-card:hover{transform:translateY(-8px);box-shadow:0 26px 60px rgba(20,20,20,.10);border-color:rgba(255,122,0,.16)}
@keyframes publicCardReveal{to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.modern-card-grid>.modern-card{opacity:1;transform:none;animation:none}.modern-card{transition:none}}

/* =========================================================
   DATA INTEGRITY — DATABASE OPERATIONS
   ========================================================= */
.integrity-database-panel {
  background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(249,250,251,.96));
}

.integrity-permission-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.integrity-permission {
  padding: 14px;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 15px;
  background: #fff;
}

.integrity-permission strong {
  display: block;
  margin-bottom: 5px;
}

.integrity-permission p {
  margin: 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.55;
}

@media (max-width: 1000px) {
  .integrity-permission-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .integrity-permission-grid {
    grid-template-columns: 1fr;
  }
}

/* V2: always-available public website home */
.portal-website-home-btn{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(148,163,184,.22);background:rgba(255,255,255,.72);color:inherit;border-radius:10px;padding:8px 10px;font-weight:700;cursor:pointer;white-space:nowrap}
.portal-website-home-btn:hover{transform:translateY(-1px)}
@media(max-width:700px){.portal-website-home-btn span{display:none}.portal-website-home-btn{padding:9px}.dashboard-topbar .search-box{display:none}}


/* =========================================================
   V10 PAGE CUT TRANSITION + RESPONSIVE PERFORMANCE
   ========================================================= */
.page-transition-shell{
  min-height:1px;
  contain:layout paint;
  will-change:opacity,transform;
}


}

/* V3 navigation transition: a gentle community pulse replaces the scissors animation. */
.page-pulse-transition{position:fixed;inset:0;z-index:10050;pointer-events:none;display:grid;place-items:center;overflow:hidden}.page-pulse-backdrop{position:absolute;inset:0;background:radial-gradient(circle at center,rgba(255,255,255,.92),rgba(248,249,251,.72) 36%,rgba(14,18,24,.08) 100%);backdrop-filter:blur(6px);animation:pulseBackdrop 3.2s ease both}.page-pulse-ring{position:absolute;width:min(42vw,470px);height:min(42vw,470px);border-radius:50%;border:1px solid rgba(255,122,0,.18);box-shadow:0 0 0 1px rgba(255,255,255,.45) inset;animation:pulseRing 3.2s cubic-bezier(.16,.8,.2,1) both}.page-pulse-ring-two{width:min(22vw,250px);height:min(22vw,250px);border-color:rgba(14,165,233,.18);animation-delay:.12s}.page-pulse-core{position:absolute;width:78px;height:78px;border-radius:28px;display:grid;place-items:center;color:#ff7a00;background:rgba(255,255,255,.92);border:1px solid rgba(255,122,0,.16);box-shadow:0 18px 45px rgba(255,122,0,.18),0 0 0 10px rgba(255,122,0,.045);animation:pulseCore 1.25s ease-in-out infinite,pulseEnter 3.2s ease both}.page-pulse-spark{position:absolute;width:9px;height:9px;border-radius:50%;background:#ff9d3e;box-shadow:0 0 18px rgba(255,122,0,.7);animation:pulseSpark 3.2s ease-out both}.page-pulse-spark-one{transform:translate(-120px,-75px)}.page-pulse-spark-two{transform:translate(125px,80px);background:#20a9e6}.page-pulse-label{position:absolute;top:58%;padding:8px 13px;border-radius:999px;background:rgba(20,23,28,.9);color:#fff;font-size:.78rem;font-weight:800;letter-spacing:.02em;box-shadow:0 14px 30px rgba(0,0,0,.15);animation:pulseLabel 3.2s ease both}@keyframes pulseBackdrop{0%{opacity:0}8%,78%{opacity:1}100%{opacity:0}}@keyframes pulseRing{0%{transform:scale(.2);opacity:0}22%{opacity:.9}100%{transform:scale(1.15);opacity:0}}@keyframes pulseCore{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}@keyframes pulseEnter{0%{opacity:0;transform:scale(.4)}14%{opacity:1;transform:scale(1)}75%{opacity:1}100%{opacity:0;transform:scale(.86)}}@keyframes pulseSpark{0%{opacity:0;transform:scale(.2)}18%{opacity:1}75%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(0,0) scale(.4)}}@keyframes pulseLabel{0%,12%{opacity:0;transform:translateY(8px)}24%,75%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-4px)}}@media(max-width:700px){.page-pulse-ring{width:72vw;height:72vw}.page-pulse-ring-two{width:38vw;height:38vw}.page-pulse-label{top:61%;font-size:.72rem}.page-pulse-core{width:68px;height:68px;border-radius:24px}}@media(prefers-reduced-motion:reduce){.page-pulse-transition{display:none!important}}

/* V3 public navigation polish */
.public-utility-bar{background:#171a20;color:#dfe3e8;font-size:12px}.public-utility-inner{width:min(1200px,92%);margin:0 auto;min-height:34px;display:flex;align-items:center;justify-content:space-between;gap:16px}.public-utility-inner span{display:inline-flex;align-items:center;gap:6px}.utility-right{opacity:.78}@media(max-width:700px){.public-utility-inner{justify-content:center;text-align:center}.public-utility-inner .utility-right{display:none}}
