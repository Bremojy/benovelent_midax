# Benevolent MIDAX backend production/development environment
# Never commit actual secret values.
NODE_ENV=production
PORT=10000
MONGO_URI=<REDACTED>
JWT_SECRET=<REDACTED>
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://benovelent-midax.vercel.app
ALLOW_VERCEL_PREVIEWS=false
ALLOW_LEGACY_SOCKET_QUERY_TOKEN=false
APP_VERSION=18.5.0
PUBLIC_WEB_URL=https://benovelent-midax.vercel.app

# Redis is optional for cache/health/rate-limiting enhancements.
UPSTASH_REDIS_REST_URL=<REDACTED>
UPSTASH_REDIS_REST_TOKEN=<REDACTED>
REDIS_REST_URL=<REDACTED>
REDIS_REST_TOKEN=<REDACTED>
REDIS_TIMEOUT_MS=1200
REDIS_KEY_PREFIX=midax

# Daraja / M-PESA STK Push
MPESA_ENABLED=true
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=<REDACTED>
MPESA_CONSUMER_SECRET=<REDACTED>
MPESA_PASSKEY=<REDACTED>
MPESA_SHORTCODE=<LIVE_STK_SHORTCODE>
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=BENMIDAX
MPESA_CALLBACK_URL=https://<BACKEND_HOST>/api/payments/callback
MPESA_TIMEZONE=Africa/Nairobi
MPESA_OAUTH_TIMEOUT_MS=15000
MPESA_REQUEST_TIMEOUT_MS=20000
MPESA_OAUTH_RETRIES=2
MPESA_RETRY_BASE_MS=250

# Manual M-PESA fallback
MPESA_MANUAL_PAYBILL=247247
MPESA_MANUAL_ACCOUNT_NUMBER=0650186528835

# M-PESA B2C (only when explicitly enabled and fully provisioned)
MPESA_B2C_ENABLED=false
MPESA_B2C_SHORTCODE=<REDACTED>
MPESA_INITIATOR_NAME=<REDACTED>
MPESA_SECURITY_CREDENTIAL=<REDACTED>
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://<BACKEND_HOST>/api/payments/b2c/result
MPESA_B2C_TIMEOUT_URL=https://<BACKEND_HOST>/api/payments/b2c/timeout

# Cloudinary (recommended for durable Render uploads)
CLOUDINARY_URL=<REDACTED>
CLOUDINARY_CLOUD_NAME=<REDACTED>
CLOUDINARY_API_KEY=<REDACTED>
CLOUDINARY_API_SECRET=<REDACTED>
UPLOAD_ROOT=/var/data/uploads
DOCUMENT_ROOT=/var/data/documents

# Email/SMS/push integrations (set only for features in use)
RESEND_API_KEY=<REDACTED>
RESEND_FROM_EMAIL=<REDACTED>
TEXTBEE_API_KEY=<REDACTED>
TEXTBEE_DEVICE_ID=<REDACTED>
TEXTBEE_API_URL=<REDACTED>
SMS_API_KEY=<REDACTED>
SMS_API_URL=<REDACTED>
VAPID_PUBLIC_KEY=<REDACTED>
VAPID_PRIVATE_KEY=<REDACTED>
VAPID_SUBJECT=mailto:<ADMIN_EMAIL>

# HTTP / auth initialization / assistant / SMTP configuration
PRESENCE_TIMEOUT_MS=90000
ADMIN_INITIAL_PASSWORD=<REDACTED>
SUPERADMIN_INITIAL_PASSWORD=<REDACTED>
RESET_ADMIN_ACCOUNTS=false
AI_API_KEY=<REDACTED>
AI_API_URL=<REDACTED>
ASSISTANT_API_KEY=<REDACTED>
ASSISTANT_API_URL=<REDACTED>
SMTP_HOST=<REDACTED>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<REDACTED>
SMTP_PASS=<REDACTED>
SMTP_FROM=<REDACTED>
EMAIL_FROM=<REDACTED>
EMAIL_REPLY_TO=<REDACTED>

# Compatibility / optional provider settings (keep disabled unless explicitly used)
JWT_EXPIRE=7d
ALLOW_LEGACY_BEARER_RESPONSE=false
RENDER=true
EMAIL_PROVIDER=resend
SMS_PROVIDER=textbee
SMS_SENDER_ID=<REDACTED>
AI_MODEL=<REDACTED>
ASSISTANT_MODEL=<REDACTED>
ASSISTANT_PROVIDER_KEY=<REDACTED>
ASSISTANT_PROVIDER_URL=<REDACTED>
MPESA_B2C_MAX_AMOUNT=150000
RESET_ALL_BENEVOLENT_DATA=false

