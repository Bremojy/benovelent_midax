PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d
ALLOW_LEGACY_BEARER_RESPONSE=false
NODE_ENV=production

# Frontend origins allowed to call the backend
CORS_ORIGINS=https://benovelent-midax.vercel.app,http://localhost:5173,http://127.0.0.1:5173
ALLOW_VERCEL_PREVIEWS=false

# Cloudinary is required for persistent production uploads
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@YOUR_VERIFIED_DOMAIN

SMS_PROVIDER=textbee

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@midax.co.ke

TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/devices
TEXTBEE_DEVICE_ID=
TEXTBEE_API_KEY=

# Optional app health/version label
APP_VERSION=16.0.0

# Optional: used only by backend/createAdminAccounts.js
ADMIN_INITIAL_PASSWORD=
SUPERADMIN_INITIAL_PASSWORD=

# SECURITY: never commit real values for any of the variables above. Rotate credentials immediately if they were ever shared publicly.
# Production CORS should contain only the deployed frontend origin(s).

# M-PESA Daraja 3.0 (server only — never put these secrets in frontend/.env)
MPESA_ENABLED=false
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=247247
MPESA_ACCOUNT_REFERENCE=0650186528835
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://benovelent-midax.onrender.com/api/payments/callback
MPESA_B2C_SHORTCODE=247247
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://benovelent-midax.onrender.com/api/payments/b2c/result
MPESA_B2C_TIMEOUT_URL=https://benovelent-midax.onrender.com/api/payments/b2c/timeout
MPESA_B2C_COMMAND_ID=BusinessPayment
